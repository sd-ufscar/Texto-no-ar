-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=64;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
	0   :   00011000;
	[1..2]  :   00001000;
	3   :   11101111;
	4   :   11111111;
	5   :   11101111;
	[6..7]  :   00001000;
	8   :   00001100;
	[9..63]  :   00000000;
END;
